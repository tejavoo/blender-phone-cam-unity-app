<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Theme.uss" />
    <ui:VisualElement name="HudRoot" class="screen-root screen-root--vignette" style="padding: 24px;">

        <ui:Image name="LiveMonitorImage" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none;" picking-mode="Ignore" />

        <ui:VisualElement name="DisconnectBanner" style="background-color: rgb(74,18,20); padding: 14px; border-radius: 12px; display: none; margin-bottom: 10px;">
            <ui:Label text="&#9888; Blender disconnected" class="text-body" style="color: white; -unity-font-style: bold;" />
            <ui:VisualElement style="flex-direction: row; margin-top: 8px;">
                <ui:Button name="ReconnectNowButton" text="Reconnect" class="button-secondary" style="margin-right: 8px; padding: 8px 20px;" />
                <ui:Button name="StopAndSaveButton" text="Stop &amp; Save" class="button-danger" style="padding: 8px 20px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="TopRow" style="flex-direction: row; justify-content: space-between; align-items: center;">
            <ui:Button name="HomeButton" text="&lt; Home" class="button-text-link text-body" />

            <ui:VisualElement name="StatusStrip" style="flex-direction: row;">
                <ui:VisualElement class="status-pill">
                    <ui:Label name="LinkIcon" text="&#10003;" class="status-pill__icon status-pill__icon--lost" />
                    <ui:Label name="LinkLabel" text="connection" class="text-caption" />
                </ui:VisualElement>
                <ui:VisualElement class="status-pill">
                    <ui:Label name="BlenderIcon" text="!" class="status-pill__icon status-pill__icon--lost" />
                    <ui:Label name="BlenderLabel" text="stream" class="text-caption" />
                </ui:VisualElement>
                <ui:VisualElement class="status-pill">
                    <ui:Label name="PoseIcon" text="&#10003;" class="status-pill__icon status-pill__icon--lost" />
                    <ui:Label name="PoseLabel" text="gyro" class="text-caption" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="HudSettingsButton" text="Settings" class="button-text-link text-body" />
        </ui:VisualElement>

        <ui:VisualElement name="RigPresetRow" style="flex-direction: row; margin-top: 20px;">
            <ui:Button name="RigHandheld" text="Handheld" class="chip text-caption" />
            <ui:Button name="RigTripod" text="Tripod" class="chip text-caption" />
            <ui:Button name="RigDolly" text="Dolly" class="chip text-caption" />
            <ui:Button name="RigCrane" text="Crane" class="chip text-caption" />
        </ui:VisualElement>

        <ui:VisualElement name="FreezeAxisRow" style="flex-direction: row; margin-top: 10px;">
            <ui:Button name="FreezeX" text="X" class="chip text-mono" style="padding: 6px 14px;" />
            <ui:Button name="FreezeY" text="Y" class="chip text-mono" style="padding: 6px 14px;" />
            <ui:Button name="FreezeZ" text="Z" class="chip text-mono" style="padding: 6px 14px;" />
            <ui:Button name="FreezePan" text="Pan-Y" class="chip text-mono" style="padding: 6px 14px;" />
            <ui:Button name="FreezeTilt" text="Tilt-X" class="chip text-mono" style="padding: 6px 14px;" />
            <ui:Button name="FreezeRoll" text="Roll-Z" class="chip text-mono" style="padding: 6px 14px;" />
        </ui:VisualElement>

        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: flex-end; align-items: flex-end;">

            <ui:VisualElement name="BigZoomSlider" style="width: 40px; margin-right: 20px; align-items: center;">
                <ui:VisualElement name="ZoomRailTrack" style="width: 6px; height: 260px; background-color: rgba(255,255,255,0.08); border-radius: 999px; position: relative;">
                    <ui:VisualElement name="ZoomRailThumb" style="width: 28px; height: 28px; border-radius: 999px; background-color: rgb(74,144,255); position: absolute; left: -11px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="RecordPanel" class="card" style="align-items: stretch; width: 260px;">
                <ui:Label name="RecordStateLabel" text="Idle" class="text-title" style="margin-bottom: 10px;" />
                <ui:VisualElement style="height: 1px; background-color: rgba(255,255,255,0.08); margin-bottom: 14px;" />
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                    <ui:Label text="Lock Start" class="text-body" />
                    <ui:Toggle name="LockStartToggle" />
                </ui:VisualElement>
                <ui:Button name="RecordButton" text="Record" class="button-primary text-body" style="width: 100%; margin-bottom: 8px; -unity-text-align: middle-center;" />
                <ui:Button name="StopButton" text="Stop" class="button-danger text-body" style="width: 100%; -unity-text-align: middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="BottomBar" style="flex-direction: row; justify-content: space-between; align-items: center; margin-top: 12px; padding: 8px 4px;">
            <ui:VisualElement style="width: 26%;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                    <ui:Label text="Steady" class="text-caption" />
                    <ui:Label name="SteadyValue" text="0.0" class="text-caption" />
                </ui:VisualElement>
                <ui:Slider name="SteadySlider" low-value="0" high-value="1" style="margin-bottom: 6px;" />
                <ui:VisualElement name="OpacityGroup">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                        <ui:Label text="Opacity" class="text-caption" />
                        <ui:Label name="OpacityValue" text="1.0" class="text-caption" />
                    </ui:VisualElement>
                    <ui:Slider name="OpacitySlider" low-value="0" high-value="1" value="1" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement style="align-items: center;">
                <ui:Label name="ZoomModeLabel" text="Zoom &#183; auto" class="text-caption" style="margin-bottom: 6px;" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Button name="ZoomMinus" text="-" class="chip text-body" style="width: 44px; -unity-text-align: middle-center; padding: 8px 0;" />
                    <ui:Label name="ZoomLabel" text="50mm" class="text-mono" style="margin: 0 12px;" />
                    <ui:Button name="ZoomPlus" text="+" class="chip text-body" style="width: 44px; -unity-text-align: middle-center; padding: 8px 0;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement style="align-items: center;">
                <ui:Label name="DollyLabel" text="Dolly &#183; 0.0m" class="text-caption" style="margin-bottom: 6px;" />
                <ui:Button name="ResetOriginButton" text="Reset Origin" class="chip text-body" />
            </ui:VisualElement>

            <ui:VisualElement style="align-items: center;">
                <ui:Label text="Zero Start" class="text-caption" style="margin-bottom: 6px;" />
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Button name="ZeroStartRopButton" text="ROP" class="chip text-body" />
                    <ui:Button name="ZeroStartRorButton" text="ROR" class="chip text-body" style="margin-right: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="CountdownOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0,0,0,0.65); display: none;">
            <ui:Label name="CountdownNumber" text="3" class="text-display" style="font-size: 220px;" />
            <ui:Button name="CountdownCancelButton" text="Cancel" class="button-secondary text-body" style="-unity-text-align: middle-center;" />
        </ui:VisualElement>

        <ui:VisualElement name="DiagnosticsOverlay" style="position: absolute; left: 24px; top: 130px; width: 460px; background-color: rgba(0,0,0,0.55); border-radius: 10px; padding: 0; display: none;">
            <ui:VisualElement name="DiagnosticsHeader" style="flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 8px 6px 12px;">
                <ui:Label text="Diagnostics &#8226; drag to move" class="text-micro" style="color: rgba(64,230,140,0.7);" />
                <ui:Button name="DiagnosticsCloseButton" text="X" class="chip text-caption" style="width: 26px; height: 26px; padding: 0; margin-right: 0; -unity-text-align: middle-center;" />
            </ui:VisualElement>
            <ui:Label name="DiagnosticsText" text="waiting..." class="text-mono" style="color: rgb(64,230,140); white-space: normal; padding: 0 12px 10px 12px;" />
        </ui:VisualElement>

        <ui:VisualElement name="SavedToast" class="terminal-readout" style="position: absolute; bottom: 110px; left: 50%; display: none;">
            <ui:Label name="SavedToastLabel" text="&#10003; Saved &#183; 0:00" class="text-mono" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
