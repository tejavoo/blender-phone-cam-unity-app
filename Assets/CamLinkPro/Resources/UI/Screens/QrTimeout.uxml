<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Theme.uss" />
    <ui:VisualElement name="QrTimeoutRoot" class="screen-root" style="align-items: center; justify-content: center; padding: 48px;">
        <ui:Label text="&#9888;" class="text-display" style="color: rgb(224,168,62); margin-bottom: 20px;" />
        <ui:Label text="Couldn't find a pairing QR code" class="text-title" style="margin-bottom: 10px; white-space: normal; -unity-text-align: upper-center;" />
        <ui:Label text="Check Blender's panel and that both devices are on the same Wi-Fi network." class="text-subtitle" style="margin-bottom: 28px; white-space: normal; -unity-text-align: upper-center;" />
        <ui:Button name="TryAgainButton" text="Try Again" class="button-primary text-body" style="width: 260px; margin-bottom: 12px; -unity-text-align: middle-center;" />
        <ui:Button name="EnterManuallyButton" text="Enter Manually" class="button-secondary text-body" style="width: 260px; margin-bottom: 12px; -unity-text-align: middle-center;" />
        <ui:Button name="CancelButton" text="Cancel" class="button-text-link text-body" />
    </ui:VisualElement>
</ui:UXML>
