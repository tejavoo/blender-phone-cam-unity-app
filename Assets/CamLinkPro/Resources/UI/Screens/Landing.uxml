<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Theme.uss" />
    <ui:VisualElement name="LandingRoot" class="screen-root" style="padding: 56px; justify-content: space-between;">

        <ui:VisualElement name="Header" style="align-items: center; margin-top: 48px;">
            <ui:Label name="Title" text="Cam Link Pro" class="text-display" />
            <ui:Label name="Subtitle" text="Made with &#10084; by Teja" class="text-subtitle" style="margin-top: 8px;" />
        </ui:VisualElement>

        <ui:VisualElement name="WifiWarning" class="card" style="background-color: rgba(138,44,48,0.9); display: none; margin-bottom: 16px;">
            <ui:Label text="Wi-Fi is off — turn it on to pair" class="text-body" style="color: white;" />
        </ui:VisualElement>

        <ui:VisualElement name="UnpairedGroup" style="align-items: center;">
            <ui:Label name="UnpairedBody" text="Pair with the Blender add-on" class="text-subtitle" style="margin-bottom: 20px;" />

            <ui:VisualElement name="RecentChips" style="flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 24px;" />

            <ui:Button name="ScanQrButton" text="Scan QR" class="button-primary text-body" style="width: 300px; margin-bottom: 14px; -unity-text-align: middle-center;" />
            <ui:Button name="EnterManuallyLink" text="Enter Manually" class="button-text-link text-body" />
        </ui:VisualElement>

        <ui:VisualElement name="PairedGroup" class="card" style="display: none; align-items: center;">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement name="PairedStatusDot" class="status-dot status-dot--good" style="margin-right: 10px;" />
                <ui:Label name="PairedHeadline" text="Connected" class="text-title" />
            </ui:VisualElement>
            <ui:Label name="PairedSubline" text="pose:5005 video/cmd:5006" class="text-caption" style="margin-top: 6px;" />
            <ui:Button name="RepairLink" text="Re-pair" class="button-secondary text-body" style="margin-top: 12px;" />
        </ui:VisualElement>

        <ui:VisualElement name="BottomBar" style="flex-direction: row; justify-content: space-between;">
            <ui:Button name="SettingsButton" text="Settings" class="button-secondary text-body" />
            <ui:Button name="LetsRecordButton" text="Let's Record" class="button-secondary text-body" />
        </ui:VisualElement>

        <ui:VisualElement name="ManualEntryModal" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0,0,0,0.6); display: none;">
            <ui:VisualElement class="card" style="width: 420px; background-color: rgb(22,20,19);">
                <ui:Label text="Enter Pairing Details" class="text-title" style="margin-bottom: 4px;" />

                <ui:VisualElement name="QrScanConfirmation" style="background-color: rgba(64,200,130,0.12); border-radius: 10px; border-width: 1px; border-color: rgba(64,200,130,0.4); padding: 10px 12px; display: none; margin-top: 12px;">
                    <ui:Label text="Scanned from QR — review and connect" class="text-caption" style="color: rgb(140,220,180); white-space: normal;" />
                </ui:VisualElement>

                <ui:TextField name="IpField" label="IP" class="text-body" style="margin-top: 16px;" />
                <ui:TextField name="PosePortField" label="Pose Port" class="text-body" style="margin-top: 10px;" />
                <ui:TextField name="VideoPortField" label="Video Port" class="text-body" style="margin-top: 10px;" />
                <ui:TextField name="TokenField" label="Token" class="text-body" style="margin-top: 10px;" />
                <ui:Label name="ManualEntryError" class="text-caption" style="color: rgb(224,100,100); display: none; margin-top: 10px; white-space: normal;" />

                <ui:VisualElement style="flex-direction: row; margin-top: 20px;">
                    <ui:Button name="ModalCancelButton" text="Cancel" class="button-secondary text-body" style="flex-grow: 1; margin-right: 10px; -unity-text-align: middle-center;" />
                    <ui:Button name="ConnectButton" text="Connect" class="button-primary text-body" style="flex-grow: 1; -unity-text-align: middle-center;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
